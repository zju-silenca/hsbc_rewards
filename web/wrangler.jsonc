{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bill-rewards",
  "compatibility_date": "2026-10-01",
  // 纯静态资源，没有 Worker 脚本：账单数据只在浏览器里处理
  "assets": {
    "directory": "./dist"
  },
  // 自定义域名（workers.dev 在内地被阻断）
  "routes": [{ "pattern": "hsbc-rewards.pi-app.kdns.fr", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": false },
  // 开发测试环境：push 到 main 自动部署（见 .github/workflows/deploy.yml），与正式站数据、脚本互不影响
  "env": {
    "dev": {
      "name": "bill-rewards-dev",
      "routes": [{ "pattern": "hsbc-rewards-dev.pi-app.kdns.fr", "custom_domain": true }],
      "workers_dev": false
    }
  }
}
