{
  "name": "bill-rewards",
  "private": true,
  "version": "1.3.6",
  "description": "信用卡账单返利看板（纯前端，Cloudflare Workers 静态资源）",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
